<%- include('header.ejs') %>

  <!-- Page Header -->
  <section style="padding: 160px 0 80px; background: linear-gradient(180deg, rgba(9, 11, 14, 0.85) 0%, var(--bg-dark) 100%), url('https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat; text-align: center;">
    <div class="container">
      <span class="section-tagline">Private Concierge</span>
      <h1 class="section-title" style="font-size: clamp(2.6rem, 5vw, 4.2rem); color: #FFFFFF;">Direct Reservations & Consultation</h1>
      <p class="section-desc" style="max-width: 680px; margin: 0 auto; color: rgba(255, 255, 255, 0.88);">
        Our senior private villa advisors are at your service for discreet consultations, bespoke itineraries, and private buyouts.
      </p>
    </div>
  </section>

  <!-- Success Notification -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="toast-banner" style="position: fixed; top: 90px; right: 24px; z-index: 9999; background: #0E281E; border: 1px solid #10B981; color: #FFFFFF; padding: 18px 24px; border-radius: var(--radius-sm); box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 14px;">
      <i class="fa-solid fa-circle-check" style="color: #10B981; font-size: 1.4rem;"></i>
      <div>
        <strong style="color: #10B981; font-size: 0.95rem;">Inquiry Sent Successfully!</strong>
        <p style="font-size: 0.85rem; color: #D1FAE5;"><%= successMessage %></p>
      </div>
    </div>
  <% } %>

  <!-- Contact & Form Section -->
  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 60px;">
        <!-- Left: Concierge Desk Contact Cards -->
        <div>
          <span class="section-tagline">White Glove Support</span>
          <h2 class="section-title" style="font-size: 2.2rem; margin-bottom: 24px;">Connect Directly With Our Desk</h2>
          <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; margin-bottom: 36px;">
            Whether you desire a private helicopter pickup from Nice airport, a specific vintage in your cellar upon arrival, or full estate buyout for an intimate wedding, we handle every detail with absolute confidentiality.
          </p>

          <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;">
            <div style="display: flex; align-items: flex-start; gap: 18px; background: var(--bg-surface); padding: 22px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-sm); background: rgba(197, 168, 128, 0.1); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 1.2rem;">
                <i class="fa-solid fa-phone"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem;">Direct Reservation Line</strong>
                <p style="color: var(--text-secondary); font-size: 0.9rem;"><%= (settings && settings.contact_phone) ? settings.contact_phone : '+1 (800) 589-2872' %></p>
                <span style="font-size: 0.75rem; color: var(--gold-primary); text-transform: uppercase;">Available 24/7/365</span>
              </div>
            </div>

            <a href="https://wa.me/917972540923?text=Hello%2C%20I%27m%20interested%20in%20your%20villas."
              target="_blank" rel="noopener noreferrer"
              aria-label="Message us on WhatsApp at +91 7972540923"
              style="display: flex; align-items: flex-start; gap: 18px; background: var(--bg-surface); padding: 22px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); color: inherit; text-decoration: none;">
              <div style="width: 48px; height: 48px; flex: 0 0 48px; border-radius: var(--radius-sm); background: rgba(37, 211, 102, 0.1); border: 1px solid rgba(37, 211, 102, 0.35); display: flex; align-items: center; justify-content: center; color: #128C4A; font-size: 1.4rem;">
                <i class="fa-brands fa-whatsapp"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem;">Message us on WhatsApp</strong>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">+91 7972540923</p>
                <span style="font-size: 0.75rem; color: #128C4A; text-transform: uppercase;">Start a direct chat</span>
              </div>
            </a>

            <div style="display: flex; align-items: flex-start; gap: 18px; background: var(--bg-surface); padding: 22px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-sm); background: rgba(197, 168, 128, 0.1); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 1.2rem;">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem;">Confidential Reservations Email</strong>
                <p style="color: var(--text-secondary); font-size: 0.9rem;"><%= (settings && settings.contact_email) ? settings.contact_email : 'reservations@auravillas.com' %></p>
                <span style="font-size: 0.75rem; color: var(--gold-primary); text-transform: uppercase;">Direct to Senior Advisors</span>
              </div>
            </div>

            <div style="display: flex; align-items: flex-start; gap: 18px; background: var(--bg-surface); padding: 22px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
              <div style="width: 48px; height: 48px; border-radius: var(--radius-sm); background: rgba(197, 168, 128, 0.1); border: 1px solid var(--border-gold); display: flex; align-items: center; justify-content: center; color: var(--gold-primary); font-size: 1.2rem;">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <strong style="color: var(--text-main); font-size: 1rem;">Global Headquarters</strong>
                <p style="color: var(--text-secondary); font-size: 0.9rem;"><%= (settings && settings.contact_address) ? settings.contact_address : '742 Ocean Boulevard, Malibu Coast, CA 90265' %></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div>
          <div style="background: var(--bg-surface); border: 1px solid var(--border-gold); border-radius: var(--radius-md); padding: 40px; box-shadow: var(--shadow-luxe);">
            <h3 style="font-size: 1.6rem; color: var(--text-main); margin-bottom: 8px;">Transmit An Inquiry</h3>
            <p style="color: var(--text-secondary); font-size: 0.92rem; margin-bottom: 28px;">
              Please complete this brief form. Your dedicated concierge advisor will respond promptly.
            </p>

            <form action="/contact_save" method="POST" data-contact-form>
              <div class="form-group">
                <label class="form-label" for="contactName">Your Full Name</label>
                <input type="text" name="name" id="contactName" class="form-control" placeholder="e.g. Lord Harrison Montgomery" required />
              </div>

              <div class="form-group">
                <label class="form-label" for="contactEmail">Email Address</label>
                <input type="email" name="email" id="contactEmail" class="form-control" placeholder="client@privatedomain.com" required />
              </div>

              <div class="form-group">
                <label class="form-label" for="contactPhone">Phone / WhatsApp</label>
                <input type="tel" name="phone" id="contactPhone" class="form-control" placeholder="+1 (415) 890-4321" required />
              </div>

              <div class="form-group">
                <label class="form-label" for="contactVilla">Preferred Residence / Destination</label>
                <input type="text" name="villa_name" id="contactVilla" class="form-control" placeholder="e.g. Villa Solaria (Amalfi) or Any Secluded Haven" />
              </div>

              <div class="form-group">
                <label class="form-label" for="contactMsg">Message / Specific Request</label>
                <textarea name="message" id="contactMsg" rows="4" class="form-control" placeholder="Tell us about desired dates, guest party size, private jet transfers, chef requirements..." required></textarea>
              </div>

              <button type="submit" class="btn btn-gold" style="width: 100%; padding: 16px; font-size: 0.95rem;">
                <i class="fa-solid fa-paper-plane"></i> Send Private Request
              </button>
              <button type="button" class="btn btn-whatsapp" data-send-contact-whatsapp style="width: 100%; padding: 16px; font-size: 0.95rem; margin-top: 10px;">
                <i class="fa-brands fa-whatsapp"></i> Send Booking on WhatsApp
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div style="margin-top: 100px; padding-top: 60px; border-top: 1px solid var(--border-subtle);">
        <div class="section-head">
          <span class="section-tagline">Clarity & Confidence</span>
          <h2 class="section-title">Frequently Asked Questions</h2>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px;">
          <div style="background: var(--bg-surface); padding: 28px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <h4 style="font-size: 1.15rem; color: var(--text-main); margin-bottom: 10px;">What is included in the nightly villa rate?</h4>
            <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.7;">
              Every stay includes private airport chauffeur transfer, daily breakfast prepared by an in-villa private chef, daily discreet housekeeping, and 24/7 dedicated concierge assistance.
            </p>
          </div>

          <div style="background: var(--bg-surface); padding: 28px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <h4 style="font-size: 1.15rem; color: var(--text-main); margin-bottom: 10px;">Can we request NDA privacy protocols?</h4>
            <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.7;">
              Yes. All of our on-site hosts, butlers, security personnel, and culinary teams sign stringent Non-Disclosure Agreements for full discretion.
            </p>
          </div>

          <div style="background: var(--bg-surface); padding: 28px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);">
            <h4 style="font-size: 1.15rem; color: var(--text-main); margin-bottom: 10px;">What is the cancellation and booking policy?</h4>
            <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.7;">
              Reservations are secured with a 30% initial deposit. Full flexible cancellation is honored up to 30 days prior to your arrival date.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

<%- include('footer.ejs') %>
