<%- include('header.ejs') %>

  <!-- Page Header -->
  <section style="padding: 160px 0 80px; background: linear-gradient(180deg, rgba(9, 11, 14, 0.85) 0%, var(--bg-dark) 100%), url('https://images.unsplash.com/photo-1570129477492-45c003edd2be?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat; text-align: center;">
    <div class="container">
      <span class="section-tagline">Tailored Hospitality</span>
      <h1 class="section-title" style="font-size: clamp(2.6rem, 5vw, 4.2rem);">Signature Experiences & Amenities</h1>
      <p class="section-desc" style="max-width: 700px; margin: 0 auto;">
        Beyond extraordinary architecture, Aura curates unforgettable moments with private chefs, yacht charters, and round-the-clock bespoke lifestyle management.
      </p>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="section">
    <div class="container">
      <div class="services-grid">
        <% services.forEach(function(s) { %>
          <div class="service-card">
            <div class="service-icon-wrap">
              <i class="fa-solid <%= s.icon %>"></i>
            </div>
            <h3 class="service-title"><%= s.title %></h3>
            <p class="service-text"><%= s.summary %></p>
          </div>
        <% }); %>
      </div>

      <!-- Bespoke Itinerary Highlight -->
      <div style="margin-top: 80px; background: var(--bg-surface); border: 1px solid var(--border-gold); border-radius: var(--radius-md); padding: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px; align-items: center;">
        <div>
          <span class="section-tagline">Custom Itineraries</span>
          <h2 style="font-size: 2.2rem; color: #FFFFFF; margin-bottom: 18px;">Curated For Your Sovereign Pleasure</h2>
          <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; margin-bottom: 24px;">
            Whether celebrating an anniversary on a private cliffside terrace in Amalfi, organizing a corporate summit in Zermatt, or chartering catamarans across the Greek Isles, our senior concierges turn your dream into reality.
          </p>
          <a href="/contact" class="btn btn-gold">
            <i class="fa-regular fa-paper-plane"></i> Request Custom Itinerary
          </a>
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=800&q=80" alt="Private Luxury Experience" style="border-radius: var(--radius-sm); width: 100%; height: 320px; object-fit: cover;" />
        </div>
      </div>
    </div>
  </section>

<%- include('footer.ejs') %>
