<%- include('header.ejs') %>

  <div class="card-header-bar" style="border: none; padding-bottom: 0; margin-bottom: 24px;">
    <div>
      <h2 style="font-size: 1.6rem; color: #FFFFFF;">Bespoke Amenities & Luxury Services</h2>
      <p style="color: var(--admin-muted); font-size: 0.88rem;">Manage signature experiences highlighted across the website and villa pages.</p>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
    <!-- Services Table -->
    <div class="admin-card">
      <div class="card-header-bar">
        <h3 class="card-title">Active Services</h3>
      </div>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Icon</th>
              <th>Service Title</th>
              <th>Description</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% services.forEach(function(s) { %>
              <tr>
                <td>#<%= s.display_order %></td>
                <td>
                  <div style="width: 36px; height: 36px; border-radius: 6px; background: rgba(197, 168, 128, 0.15); display: flex; align-items: center; justify-content: center; color: var(--admin-gold);">
                    <i class="fa-solid <%= s.icon %>"></i>
                  </div>
                </td>
                <td><strong style="color: #FFFFFF;"><%= s.title %></strong></td>
                <td><span style="font-size: 0.85rem; color: var(--admin-muted);"><%= s.summary %></span></td>
                <td>
                  <a href="/admin/delete_service/<%= s.id %>" class="btn-admin btn-admin-danger btn-admin-sm confirm-delete" data-message="Are you sure you want to remove this service?">
                    <i class="fa-solid fa-trash"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Add Service Form -->
    <div class="admin-card">
      <div class="card-header-bar">
        <h3 class="card-title"><i class="fa-solid fa-plus text-gold"></i> Add New Service</h3>
      </div>
      <form action="/admin/save_service" method="POST">
        <div class="admin-form-group">
          <label class="admin-form-label" for="svcTitle">Service Title</label>
          <input type="text" name="title" id="svcTitle" class="admin-input" placeholder="e.g. Private Sommelier Tastings" required />
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label" for="svcIcon">FontAwesome Icon Class</label>
          <input type="text" name="icon" id="svcIcon" class="admin-input" placeholder="fa-wine-bottle" value="fa-gem" required />
          <span style="font-size: 0.75rem; color: var(--admin-muted);">E.g. fa-utensils, fa-ship, fa-spa, fa-helicopter, fa-car</span>
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label" for="svcOrder">Display Order</label>
          <input type="number" name="display_order" id="svcOrder" class="admin-input" value="7" />
        </div>

        <div class="admin-form-group">
          <label class="admin-form-label" for="svcSummary">Summary Description</label>
          <textarea name="summary" id="svcSummary" rows="3" class="admin-textarea" placeholder="Detailed service description for prospective guests..." required></textarea>
        </div>

        <button type="submit" class="btn-admin btn-admin-gold" style="width: 100%; justify-content: center; padding: 12px;">
          <i class="fa-solid fa-plus"></i> Save Service
        </button>
      </form>
    </div>
  </div>

<%- include('footer.ejs') %>
