<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Aura Villas CMS Admin' %></title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <h2>Aura <span>Villas</span></h2>
      <p>Management CMS</p>
    </div>

    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'active' : '' %>">
        <i class="fa-solid fa-chart-pie"></i> Dashboard
      </a>
      <a href="/admin/villas" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'villas') ? 'active' : '' %>">
        <i class="fa-solid fa-hotel"></i> Manage Villas
      </a>
      <a href="/admin/inquiries" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'inquiries') ? 'active' : '' %>">
        <i class="fa-solid fa-envelope-open-text"></i> Bookings & Inquiries
      </a>
      <a href="/admin/services" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'services') ? 'active' : '' %>">
        <i class="fa-solid fa-concierge-bell"></i> Luxury Services
      </a>
      <a href="/admin/reviews" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'reviews') ? 'active' : '' %>">
        <i class="fa-solid fa-star"></i> Guest Reviews
      </a>
      <a href="/admin/settings" class="sidebar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'settings') ? 'active' : '' %>">
        <i class="fa-solid fa-sliders"></i> Site Settings
      </a>
      <a href="/" target="_blank" class="sidebar-link" style="margin-top: 14px; border-top: 1px solid var(--admin-border); padding-top: 16px;">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> View Public Site
      </a>
    </nav>

    <div class="sidebar-footer">
      <div style="font-size: 0.85rem;">
        <strong style="color: #FFFFFF; display: block;"><%= (typeof adminUser !== 'undefined' && adminUser.name) ? adminUser.name : 'Administrator' %></strong>
        <span style="color: var(--admin-muted); font-size: 0.75rem;">Senior Manager</span>
      </div>
      <a href="/admin/logout" style="color: #EF4444; font-size: 1.1rem; padding: 6px;" title="Logout">
        <i class="fa-solid fa-right-from-bracket"></i>
      </a>
    </div>
  </aside>

  <!-- Main Workspace -->
  <main class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-title">
        <%= typeof title !== 'undefined' ? title : 'Aura Control Center' %>
      </div>

      <div class="admin-user-pill">
        <span style="font-size: 0.85rem; color: var(--admin-muted);">Signed in as <strong style="color: var(--admin-gold);"><%= (typeof adminUser !== 'undefined' && adminUser.username) ? adminUser.username : 'admin' %></strong></span>
        <div class="user-badge">AV</div>
      </div>
    </header>

    <div class="admin-content">
